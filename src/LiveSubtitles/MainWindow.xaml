<Window x:Class="LiveSubtitles.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="实时翻译字幕" Icon="Assets/livesubtitles.ico" Width="740" Height="560" MinWidth="640" MinHeight="500" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="导出文字…" Click="ExportText" />
        <MenuItem Header="导出字幕 SRT…" Click="ExportSrt" />
        <Separator />
        <MenuItem Header="退出" Click="ExitClick" />
      </MenuItem>
      <MenuItem Header="设置(_S)">
        <MenuItem Header="高级设置…" Click="AdvancedClick" />
        <MenuItem Header="刷新音频设备" Click="RefreshDevices" />
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="使用说明" Click="HelpClick" />
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪" TextTrimming="CharacterEllipsis" MaxWidth="610" />
      </StatusBarItem>
    </StatusBar>
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="InputPanel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="音频来源：" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="DeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
        <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Click="RefreshDevices" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="35" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="翻译方向：" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" x:Name="SourceBox" DisplayMemberPath="Name" SelectedValuePath="Value" MaxDropDownHeight="320" ToolTip="选择音频语言；不确定时可选自动识别。" />
        <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ComboBox Grid.Column="3" x:Name="TargetBox" DisplayMemberPath="Name" SelectedValuePath="Value" MaxDropDownHeight="320" ToolTip="选择字幕译文的语言。" />
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,14">
        <Button x:Name="StartButton" Content="开始" Click="StartClick" />
        <Button x:Name="PauseButton" Content="暂停" IsEnabled="False" Click="PauseClick" />
        <Button x:Name="StopButton" Content="停止" IsEnabled="False" Click="StopClick" />
        <Button Content="清空" Click="ClearClick" />
        <Separator Width="14" Opacity="0" />
        <Button Content="显示 / 隐藏字幕" Click="ToggleOverlay" />
        <CheckBox x:Name="LockBox" Content="锁定 / 穿透" VerticalAlignment="Center" Click="LockChanged" />
      </StackPanel>
      <GroupBox Header="字幕样式" Grid.Row="3" Padding="10,8" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="BilingualBox" Content="显示原文" IsChecked="True" VerticalAlignment="Center" Click="StyleChanged" />
          <TextBlock Text="字号" Margin="22,0,8,0" VerticalAlignment="Center" />
          <Slider x:Name="FontSlider" Width="110" Minimum="16" Maximum="42" Value="26" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleChanged" />
          <TextBlock Text="底色" Margin="22,0,8,0" VerticalAlignment="Center" />
          <Slider x:Name="OpacitySlider" Width="110" Minimum="0.15" Maximum="1" Value="0.78" ValueChanged="StyleChanged" />
        </StackPanel>
      </GroupBox>
      <GroupBox Grid.Row="4" Header="本次字幕记录" Padding="0">
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="White">
          <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70" />
            <DataGridTextColumn Header="原文" Binding="{Binding Source}" Width="*" />
            <DataGridTextColumn Header="译文" Binding="{Binding Translation}" Width="*" />
            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </GroupBox>
      <DockPanel Grid.Row="5" Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="复制" Click="CopyClick" />
          <Button Content="高级设置…" Click="AdvancedClick" Margin="0" />
        </StackPanel>
        <TextBlock x:Name="KeyHint" Text="Ctrl+Alt+Space 开始/暂停  ·  L 锁定  ·  H 显示" FontSize="11" Foreground="#555555" VerticalAlignment="Center" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
