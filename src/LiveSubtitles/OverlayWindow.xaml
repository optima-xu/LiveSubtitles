<Window x:Class="LiveSubtitles.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="实时翻译字幕 · 悬浮字幕" Width="920" Height="156" MinWidth="340" MinHeight="110" MaxHeight="300" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="CanResizeWithGrip">
  <Border x:Name="Surface" Background="#C7000000" BorderThickness="1" BorderBrush="#777777" Padding="18,10" MouseLeftButtonDown="DragCaption">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="SourceRow" Height="28" />
        <RowDefinition Height="*" />
        <RowDefinition Height="18" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="Original" Foreground="#D0D0D0" FontSize="17" TextTrimming="CharacterEllipsis" Text="等待电脑声音…" />
      <TextBlock Grid.Row="1" x:Name="Translated" Foreground="White" FontSize="26" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="实时翻译字幕" />
      <TextBlock Grid.Row="2" x:Name="Hint" Foreground="#AAAAAA" FontSize="11" Text="拖动可移动 · Ctrl+Alt+L 锁定 / 解锁" />
    </Grid>
  </Border>
</Window>